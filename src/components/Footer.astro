---
const links = [
  { label: "Privacy", href: "/privacy/" },
  { label: "GitHub", href: "https://github.com/LVTD-LLC/nitpick" },
  { label: "README", href: "https://github.com/LVTD-LLC/nitpick#readme" },
  { label: "Skill for agents", href: "https://github.com/LVTD-LLC/nitpick-skills" },
  { label: "Homebrew tap", href: "https://github.com/LVTD-LLC/homebrew-tap" },
  { label: "MIT License", href: "https://github.com/LVTD-LLC/nitpick/blob/main/LICENSE" },
];
---

<footer class="footer">
  <div class="footer-inner">
    <nav class="links" aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <p class="legal">&copy; {new Date().getFullYear()} LVTD LLC. Built by agents, reviewed by nitpick.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--primary);
    color: var(--ink);
    padding: 36px var(--gutter);
  }
  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    font-weight: 600;
    font-size: 15px;
  }
  .links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  .links a:hover,
  .links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .links a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .legal {
    margin: 0;
  }
</style>
