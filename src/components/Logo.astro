---
interface Props {
  size?: number;
  inverted?: boolean;
}
const { size = 28, inverted = false } = Astro.props;
---

<span class="logo" style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 64 64" width={size} height={size}>
    <rect width="64" height="64" rx="8" fill={inverted ? "#ffffff" : "#FF4500"}></rect>
    <path
      fill={inverted ? "#FF4500" : "#ffffff"}
      d="M16 48V18h8v4.2c2.4-3.2 6-5 10.4-5C42 17.2 48 22 48 30.6V48h-8V31.8c0-4.6-2.6-7.4-6.8-7.4-4.6 0-7.2 3.2-7.2 8V48z"
    ></path>
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    width: var(--s);
    height: var(--s);
    flex: none;
  }
</style>
