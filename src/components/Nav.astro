---
import Logo from "./Logo.astro";
---

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="nitpick home">
      <Logo size={30} />
      <span class="brand-name">nitpick</span>
    </a>
    <nav class="actions" aria-label="Primary">
      <a class="quiet" href="https://github.com/LVTD-LLC/nitpick-skills">Skill</a>
      <a class="pill pill-ink" href="https://github.com/LVTD-LLC/nitpick">
        GitHub
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    background: #fff;
  }
  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .brand:focus-visible,
  .quiet:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .quiet {
    font-weight: 600;
    font-size: 15px;
  }
  .quiet:hover,
  .quiet:focus-visible {
    color: var(--primary-text);
  }
  .actions .pill {
    height: 40px;
    padding: 0 18px;
    font-size: 15px;
  }
</style>
