---
import Logo from "./Logo.astro";

const links = [
  { href: "#what", label: "What it does" },
  { href: "#how", label: "How it works" },
  { href: "#setup", label: "Setup" },
  { href: "https://github.com/LVTD-LLC/nitpick#configuration", label: "Config" },
];
---

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="nitpick home">
      <Logo size={30} />
      <span class="brand-name">nitpick</span>
    </a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="quiet" href="https://github.com/LVTD-LLC/nitpick-skills">For agents</a>
      <a class="pill pill-ink" href="https://github.com/LVTD-LLC/nitpick">
        GitHub
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <svg class="icon-open" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <svg class="icon-close" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Primary, mobile" hidden data-mobile-menu>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="https://github.com/LVTD-LLC/nitpick-skills">For agents</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.hidden = !open;
    };
    toggle.addEventListener("click", () => set(menu.hasAttribute("hidden")));
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hasAttribute("hidden")) {
        set(false);
        toggle.focus();
      }
    });
    window.matchMedia("(min-width: 901px)").addEventListener("change", (e) => {
      if (e.matches) set(false);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .links {
    display: flex;
    gap: 28px;
    margin-left: auto;
    margin-right: auto;
    font-weight: 600;
    font-size: 15px;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--primary-text);
  }
  .links a:focus-visible,
  .quiet:focus-visible,
  .brand:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }
  .quiet {
    font-weight: 600;
    font-size: 15px;
  }
  .quiet:hover,
  .quiet:focus-visible {
    color: var(--primary-text);
  }
  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  .menu-toggle svg {
    width: 20px;
    height: 20px;
  }
  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }
  .menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }
  .menu-toggle:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .mobile-menu {
    display: none;
  }
  .actions .pill {
    height: 40px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .links {
      display: none;
    }
    .quiet {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
    .mobile-menu {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--line);
      padding: 8px var(--gutter) 16px;
      background: #fff;
    }
    .mobile-menu[hidden] {
      display: none;
    }
    .mobile-menu a {
      padding: 14px 4px;
      border-bottom: 1px solid var(--line);
      font-weight: 600;
      font-size: 17px;
    }
    .mobile-menu a:last-child {
      border-bottom: 0;
    }
    .mobile-menu a:hover,
    .mobile-menu a:focus-visible {
      color: var(--primary-text);
    }
    .mobile-menu a:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: -2px;
    }
  }
</style>
