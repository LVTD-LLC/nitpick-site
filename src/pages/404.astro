---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — nitpick" description="That page does not exist.">
  <section class="band no-rule">
    <div class="frame wrap">
      <p class="eyebrow">404</p>
      <h1 class="h-section"><span class="mark mark-primary">No findings here.</span></h1>
      <p class="muted">That page does not exist. The README has everything the site does, and more.</p>
      <div class="actions">
        <a class="pill pill-ink" href="/">Back home</a>
        <a class="pill pill-soft" href="https://github.com/LVTD-LLC/nitpick#readme">Read the README</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap {
    min-height: 60vh;
    padding: 120px var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
</style>
