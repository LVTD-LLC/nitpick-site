---
import Base from "../layouts/Base.astro";
import Cast from "../components/Cast.astro";

const title = "nitpick — double-check the code your AI agent writes";
const description =
  "nitpick sends your diff, the changed files, and the code around them to a second model on OpenRouter and prints findings your agent fixes before opening the PR. One command, or none: hook it into your agent and it reviews each batch of edits in the background.";

// The prompt a user pastes into their coding agent. The setup steps live in the
// nitpick-setup skill in github.com/LVTD-LLC/nitpick-skills; keep this a pointer to it.
const prompt =
  "Set up nitpick for me by following https://raw.githubusercontent.com/LVTD-LLC/nitpick-skills/main/plugins/nitpick/skills/nitpick-setup/SKILL.md";

const brew = "brew install LVTD-LLC/tap/nitpick";

const how = [
  {
    n: "01",
    title: "It packs the change, not just the diff.",
    body: "The unified diff, the full post-change files, and unchanged code chosen for a reason: definitions the diff uses, call sites of what it changed, the modules it imports, and matching tests. Ranked and trimmed to a token budget in milliseconds.",
  },
  {
    n: "02",
    title: "It asks a different model, through OpenRouter.",
    body: "OpenRouter is the default provider, so one key gives nitpick every model there. Pick one with -m, or several at once; findings that agree are merged and marked (2/2 models). Point it at Ollama or llama.cpp instead and nothing leaves your machine.",
  },
  {
    n: "03",
    title: "It returns findings with an exit code.",
    body: "Each finding cites path:line in the post-change file with a severity, a category, and a suggestion. Exit 1 when anything is at or above --fail-on (high by default), so the agent fixes, reruns, and only opens the PR at exit 0.",
  },
  {
    n: "04",
    title: "Or it watches, and the agent never runs anything.",
    body: "nitpick watch hooks into Claude Code, Codex, Cursor, pi, OpenCode or OpenClaw. With global hooks installed, each workspace gets a background worker that reviews only what changed since it last looked; findings reach the agent as a [nitpick] note after its next tool call, and the stop hook returns immediately while reviews continue. Blocking on high or blocker findings is opt-in. It also watches source files in plain folders without Git, sending changed source files without related repository context. A review that could not run is logged, not reported as a failure, so free models are fine here.",
  },
];

const more = [
  ["nitpick --staged", "only what is staged"],
  ["nitpick --base develop", "diff against another branch"],
  ["nitpick src/api/", "limit the review to some paths"],
  ["nitpick -m openai/gpt-5.5 -m anthropic/claude-opus-5-5", "two models in parallel, findings merged"],
  ['nitpick -f "Focus on the SQL."', "extra instructions for this run"],
  ["nitpick --fail-on medium", "stricter exit code"],
  ["nitpick --provider ollama -m qwen3-coder:30b", "local model, no key"],
  ["nitpick init", "write a starter .nitpick.toml"],
  ["nitpick watch install codex --global", "background review in every repo (Claude Code: the plugin does this)"],
  ["nitpick watch status", "is it on, what is waiting, what it found"],
  ["nitpick watch log", "every background finding so far"],
];
---

<Base title={title} description={description}>
  <!-- Hero -->
  <section class="band no-rule">
    <div class="frame hero">
      <p class="eyebrow">AI code review for AI agents</p>
      <h1 class="h-display">
        <span class="mark mark-primary">Double-check</span> the code your agent just wrote.
      </h1>
      <p class="lede hero-lede">
        nitpick sends the diff, the changed files, and the code around them to a different model, and prints findings
        the agent fixes before opening the PR. One command, or none: hook it into the agent and it reviews each burst of
        edits in the background.
      </p>
    </div>
  </section>

  <!-- Install prompt -->
  <section class="band" id="install">
    <div class="frame install">
      <div class="install-head">
        <h2 class="h-section">Paste this into your agent.</h2>
        <p class="muted install-sub">
          The agent follows the nitpick setup skill: it installs the CLI and the plugin, asks for a model key, turns on
          background review in every workspace, and checks that it works. Claude Code, Codex, Cursor, pi, OpenClaw,
          OpenCode, and anything that reads Agent Skills.
        </p>
      </div>
      <div class="prompt-box">
        <div class="prompt-bar">
          <span class="prompt-label">prompt</span>
          <button class="pill pill-ink copy" data-copy={prompt} type="button">
            <span class="copy-label">Copy prompt</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="8" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H10" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
        </div>
        <pre class="prompt-text">{prompt}</pre>
      </div>
      <p class="by-hand">
        <span class="muted">Rather do it yourself?</span>
        <button class="pill pill-soft pill-mono copy" data-copy={brew} type="button">
          <span class="copy-label">{brew}</span>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="8" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H10" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <a class="muted link" href="https://github.com/LVTD-LLC/nitpick#readme">then read the README</a>
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="band" id="how">
    <div class="frame pad">
      <h2 class="h-section">How it works</h2>
      <ol class="how" role="list">
        {
          how.map((h) => (
            <li class="how-item">
              <span class="how-n">{h.n}</span>
              <h3 class="h-card">{h.title}</h3>
              <p class="muted">{h.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="how-key">
        <span class="mark mark-lemon">export NITPICK_OPENROUTER_API_KEY=sk-or-…</span>
        <span class="muted">works for terminal sessions. For GUI background hooks, configure <code>api_key</code> in <code>~/.config/nitpick/config.toml</code> with owner-only permissions (<code>chmod 600</code>). Get a key at openrouter.ai; models are billed per token, and several are free.</span>
      </p>
    </div>
  </section>

  <!-- Recordings -->
  <section class="band" id="output">
    <div class="frame pad">
      <h2 class="h-section">What it looks like</h2>
      <p class="lede section-lede">
        Real recordings against a branch of nitpick's own repo, with two one-line bugs planted in it. Scrub the
        timelines or just read the final screens.
      </p>

      <div class="demo">
        <div class="demo-copy">
          <h3 class="h-card">Review the working tree</h3>
          <p class="muted">
            The default. Progress on stderr, the review on stdout. This repo's .nitpick.toml names two models, so both
            run and their findings are merged.
          </p>
        </div>
        <Cast src="/casts/review.cast" command="nitpick" rows={52} />
      </div>

      <div class="demo">
        <div class="demo-copy">
          <h3 class="h-card">See what would be sent</h3>
          <p class="muted">
            No model call. The stats show what the payload costs in tokens; the tags list every file and snippet with
            the reason it was included.
          </p>
        </div>
        <Cast src="/casts/context.cast" command={'nitpick context --json | jq .stats\nnitpick context | grep -E "^<(file|snippet|importers) "'}
          rows={30}
        />
      </div>

      <div class="demo">
        <div class="demo-copy">
          <h3 class="h-card">Get it as JSON</h3>
          <p class="muted">
            The same review as one object: verdict, findings with file and line, per-model summaries, token counts and
            cost. Built for the agent, not the human.
          </p>
        </div>
        <Cast src="/casts/json.cast" command='nitpick --json -m stealth/space-bunny-alpha | jq "{verdict, findings: [.findings[] | {file, line, severity, title}]}"'
          rows={24}
        />
      </div>

      <div class="more">
        <h3 class="h-card">More commands</h3>
        <dl class="more-list">
          {
            more.map(([cmd, desc]) => (
              <div class="more-row">
                <dt>
                  <code>{cmd}</code>
                </dt>
                <dd class="muted">{desc}</dd>
              </div>
            ))
          }
        </dl>
        <a class="pill pill-soft" href="https://github.com/LVTD-LLC/nitpick#usage">
          Every flag, in the README
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Clipboard API first; fall back to a selection copy where the API is missing or denied.
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement("textarea");
      area.value = text;
      area.setAttribute("readonly", "");
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.append(area);
      area.select();
      // execCommand is deprecated but remains the only synchronous fallback browsers still honor.
      const legacy = document as unknown as { execCommand(command: string): boolean };
      let ok = false;
      try {
        ok = legacy.execCommand("copy");
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy")) {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector<HTMLElement>(".copy-label");
      const original = label?.textContent ?? "";
      const ok = await copyText(btn.dataset.copy ?? "");
      if (label) label.textContent = ok ? "Copied" : "Copy failed";
      window.setTimeout(() => {
        if (label) label.textContent = original;
      }, 1400);
    });
  }
</script>

<style>
  .section-lede {
    margin-top: 16px;
    max-width: 62ch;
  }

  /* Hero */
  .hero {
    background: var(--surface);
    padding: 88px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }
  .hero h1 {
    max-width: 18ch;
    line-height: 1.12;
  }
  .hero-lede {
    max-width: 52ch;
  }
  @media (max-width: 720px) {
    .hero {
      padding: 56px var(--gutter) 48px;
    }
  }

  /* Install prompt */
  .install {
    padding: 80px var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .install-sub {
    margin-top: 14px;
    max-width: 64ch;
  }
  .prompt-box {
    border: 1px solid var(--line-strong);
    background: #fff;
  }
  .prompt-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 10px 18px;
    border-bottom: 1px solid var(--line-strong);
    background: var(--lemon);
  }
  .prompt-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .prompt-bar .pill {
    height: 38px;
    border-radius: 0;
  }
  .prompt-text {
    margin: 0;
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--ink);
  }
  .by-hand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .by-hand .pill {
    height: 38px;
  }
  .link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .link:hover,
  .link:focus-visible {
    color: var(--primary-text);
  }
  .link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
  @media (max-width: 720px) {
    .install {
      padding: 56px var(--gutter);
    }
    .prompt-text {
      padding: 16px;
      font-size: 12.5px;
    }
    .by-hand .pill-mono {
      font-size: 12px;
      padding: 0 12px;
    }
  }

  /* How it works */
  .how {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 24px;
  }
  .how-item {
    border-top: 1px solid var(--line-strong);
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .how-n {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--ink);
    color: #fff;
    padding: 4px 8px;
    align-self: flex-start;
  }
  .how-key {
    margin-top: 48px;
    font-size: 16px;
    line-height: 1.7;
  }
  .how-key .mark {
    font-family: var(--font-mono);
    font-size: 14px;
    margin-right: 8px;
  }
  @media (max-width: 900px) {
    .how {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
  }

  /* Recordings */
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 24px;
    margin-top: 64px;
    align-items: start;
  }
  .demo-copy {
    border-top: 1px solid var(--line-strong);
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 900px) {
    .demo {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 48px;
    }
  }

  .more {
    margin-top: 80px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .more-list {
    margin: 0;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .more-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .more-row dt code {
    font-size: 13.5px;
    word-break: break-word;
  }
  .more-row dd {
    margin: 0;
    font-size: 15px;
  }
  @media (max-width: 720px) {
    .more-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
