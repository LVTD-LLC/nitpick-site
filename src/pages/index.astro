---
import Base from "../layouts/Base.astro";

const title = "nitpick — AI code review for AI agents";
const description =
  "nitpick sends your diff, the changed files, and the code around them to a different model and prints structured findings your agent can loop on. One command, exit code 1 when it matters.";

const clients = ["Claude Code", "Codex", "Cursor", "OpenCode", "OpenClaw", "Agent Skills"];

const capabilities = [
  {
    title: "Loop until clean",
    body: "Exit code 1 when any finding is at or above --fail-on. The agent fixes, reruns, and opens the PR when it hits 0.",
    tone: "surface",
  },
  {
    title: "Merge opinions",
    body: "Pass -m more than once. Models run in parallel; findings that agree are merged and shown as (2/3 models).",
    tone: "lemon",
  },
  {
    title: "Focus the review",
    body: "A -f note for this run, or standing instructions in .nitpick.toml. “Be strict about N+1 queries.”",
    tone: "pink",
  },
  {
    title: "Stay local",
    body: "Point it at Ollama or llama.cpp. Nothing leaves the machine except the request to the provider you chose.",
    tone: "mint",
  },
  {
    title: "Machine-readable",
    body: "--json returns the verdict, findings[], per-model summaries, token counts and cost as one object.",
    tone: "sky",
  },
  {
    title: "Scope it",
    body: "--staged, --base develop, --range main..HEAD, or a path. Auto-detect compares against the merge-base.",
    tone: "paper",
  },
  {
    title: "Context in milliseconds",
    body: "One parallel walk with the ripgrep crates, tree-sitter for six languages, ranked and trimmed to a token budget.",
    tone: "lemon",
  },
  {
    title: "One static binary",
    body: "Rust. brew install or cargo install. Startup time is a feature, and there are no dependencies to babysit.",
    tone: "surface",
  },
];

const setups = [
  {
    id: "claude",
    label: "Set up Claude Code",
    blurb: "Install the plugin from the nitpick-skills marketplace. It teaches the agent to install nitpick, run it before a PR, and loop on findings.",
    code: `claude plugin marketplace add LVTD-LLC/nitpick-skills
claude plugin install nitpick@nitpick-skills`,
    chips: [["Plugin", "nitpick@nitpick-skills"], ["Also", "Codex", "Cursor", "OpenCode"]],
  },
  {
    id: "codex",
    label: "Set up Codex",
    blurb: "Same skill, packaged for Codex. One marketplace add, one plugin add.",
    code: `codex plugin marketplace add LVTD-LLC/nitpick-skills
codex plugin add nitpick@nitpick-skills`,
    chips: [["Plugin", "nitpick@nitpick-skills"], ["Format", "Agent Skills"]],
  },
  {
    id: "agents",
    label: "Add it to AGENTS.md",
    blurb: "No plugin system? A few lines in AGENTS.md or CLAUDE.md is all an agent needs.",
    code: `Before opening a PR, run \`nitpick\` from the repo root.
Fix every finding at severity high or blocker, then run it
again until it exits 0. Findings at medium or below are
judgment calls; address or explain them in the PR.`,
    chips: [["Works with", "any agent"], ["Exit codes", "0", "1", "2"]],
  },
  {
    id: "config",
    label: "Write a .nitpick.toml",
    blurb: "Pin models, set the severity that fails the run, ignore generated files, and give the reviewer standing instructions.",
    code: `model = ["stealth/space-bunny-alpha", "nvidia/nemotron-3-ultra-550b-a55b:free"]
fail_on = "high"
budget_tokens = 80000
ignore = ["**/*.lock", "**/generated/**"]
instructions = """
This is a Django app. Be strict about N+1 queries.
Ignore anything about docstrings.
"""`,
    chips: [["Precedence", "flags", "env", ".nitpick.toml"], ["Init", "nitpick init"]],
  },
  {
    id: "local",
    label: "Run a local model",
    blurb: "Any OpenAI-compatible server works. Ollama and llama.cpp have presets and need no API key.",
    code: `nitpick --provider ollama -m qwen3-coder:30b
nitpick --provider llamacpp -m whatever-the-server-loaded
nitpick --provider openai --base-url http://localhost:1234/v1 -m local-model`,
    chips: [["Providers", "openrouter", "ollama", "llamacpp", "openai"]],
  },
];

const steps = [
  {
    n: "01",
    title: "Install",
    body: "One formula from the tap, or build from source with Rust 1.98 or newer. Either way you get a single static binary.",
    code: "brew install LVTD-LLC/tap/nitpick",
  },
  {
    n: "02",
    title: "Set a key",
    body: "An OpenRouter key is all nitpick needs. Skip it entirely for Ollama and llama.cpp.",
    code: "export NITPICK_OPENROUTER_API_KEY=sk-or-\u2026",
  },
  {
    n: "03",
    title: "Run it",
    body: "From the repo root, before the PR. Read the findings, fix what matters, run it again.",
    code: "nitpick",
  },
];

const stats = [
  { value: "1", label: "command before the PR", tone: "pink" },
  { value: "6", label: "languages with tree-sitter", tone: "surface" },
  { value: "80k", label: "tokens of context by default", tone: "lemon" },
  { value: "MIT", label: "licensed, single static binary", tone: "sky" },
];
---

<Base title={title} description={description}>
  <!-- Hero -->
  <section class="band no-rule hero">
    <div class="frame hero-frame">
      <div class="hero-copy">
        <h1 class="h-display">
          <span class="mark mark-primary">AI code review</span><br />
          <span class="mark mark-primary">for AI agents.</span>
        </h1>
        <p class="lede hero-lede">
          nitpick sends your diff, the changed files, and the code that matters to a different model, and prints
          findings your agent can loop on.
        </p>
        <div class="hero-actions">
          <button class="pill pill-ink pill-mono copy" data-copy="brew install LVTD-LLC/tap/nitpick" type="button">
            <span class="copy-label">brew install LVTD-LLC/tap/nitpick</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="8" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H10" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
          <a class="pill pill-soft" href="#setup">
            Set up for agents
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
      </div>
      <img class="hero-art" src="/art/hero.png" width="1440" height="760" alt="" fetchpriority="high" />
    </div>
  </section>

  <!-- Works with -->
  <section class="band">
    <div class="frame pad clients">
      <p class="clients-title">Works with the agent you already run.</p>
      <ul class="clients-grid" role="list">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- What it sends -->
  <section class="band" id="what">
    <div class="frame pad">
      <h2 class="h-section">See what <span class="accent">a second model</span> sees.</h2>
      <p class="lede section-lede">
        Not just the diff. nitpick packs the whole changed file and the code around it, each piece labeled with why it
        is there.
      </p>

      <div class="feature">
        <div class="feature-copy">
          <h3 class="h-card">The diff, plus the whole file</h3>
          <p class="muted">
            The unified diff and the full post-change content of every changed file, numbered so findings cite exact
            lines. Big files are windowed around the change.
          </p>
          <a class="mono-link" href="https://github.com/LVTD-LLC/nitpick#what-gets-sent">What gets sent</a>
        </div>
        <div class="feature-panel tone-surface">
          <pre class="terminal"><span class="dim">## Changed files</span>

<span class="dim">### src/diff.rs (post-change, numbered)</span>
<span class="dim"> 58 │</span> /// Inclusive line ranges touched by each hunk.
<span class="dim"> 59 │</span> pub fn new_ranges(&amp;self) -&gt; Vec&lt;(usize, usize)&gt; {'{'}
<span class="dim"> 60 │</span>     self.hunks
<span class="dim"> 61 │</span>         .iter()
<span class="hot"> 62 │</span>         .map(|h| (h.new_start, h.new_start + h.new_len))
<span class="dim"> 63 │</span>         .collect()
<span class="dim"> 64 │</span> {'}'}</pre>
        </div>
      </div>

      <div class="feature">
        <div class="feature-copy">
          <h3 class="h-card">Related code, labeled with why</h3>
          <p class="muted">
            Definitions of symbols the diff references. Call sites of symbols it changed. Modules it imports, files
            that import it, and the tests that match. Ranked and trimmed to a token budget.
          </p>
          <a class="mono-link" href="https://github.com/LVTD-LLC/nitpick#what-gets-sent">How context is chosen</a>
        </div>
        <div class="feature-panel tone-surface-2">
          <pre class="terminal"><span class="dim">## Related context (unchanged code)</span>

<span class="tag">call site of new_ranges</span>  <span class="dim">src/context.rs:441</span>
    for (s, e) in diff.new_ranges() {'{'}
        let window = &amp;lines[(s - 1)..e];

<span class="tag">definition of Hunk</span>  <span class="dim">src/diff.rs:12</span>
    pub struct Hunk {'{'} pub new_start: usize, pub new_len: usize, .. {'}'}

<span class="tag">tests matching src/diff.rs</span>  <span class="dim">src/diff.rs:210</span>
    #[test] fn ranges_are_inclusive() {'{'} .. {'}'}</pre>
        </div>
      </div>

      <div class="feature">
        <div class="feature-copy">
          <h3 class="h-card">Structured findings with an exit code</h3>
          <p class="muted">
            Severity, category, path:line in the post-change file, and a suggestion. Exit 1 when anything is at or
            above the level you chose, so the agent knows to keep going.
          </p>
          <a class="mono-link" href="https://github.com/LVTD-LLC/nitpick#exit-codes">Exit codes</a>
        </div>
        <div class="feature-panel tone-surface">
          <pre class="terminal"><span class="dim">$</span> nitpick
<span class="dim">nitpick: working tree vs merge-base with main (3f1c2a9) · 2 file(s) · ~7.8k tokens context</span>
<span class="dim">nitpick: stealth/space-bunny-alpha done in 41.2s, 2 finding(s)</span>

# nitpick: <span class="hot">request changes</span>

## Findings (2)

### High
- <span class="key">src/diff.rs:62</span> new_ranges now returns an exclusive end <span class="dim">[bug]</span>
  Both callers treat the range as inclusive; `windowed_listing`
  slices `lines[..e]` and will panic on the last hunk of a file.
  <span class="ok">Suggestion:</span> restore `h.new_start + h.new_len - 1`.

<span class="hot">2 finding(s) at or above `high`. Exit code 1.</span></pre>
        </div>
      </div>

      <div class="feature">
        <div class="feature-copy">
          <h3 class="h-card">Any model. Any provider.</h3>
          <p class="muted">
            OpenRouter by default. Ollama and llama.cpp presets for local review. Any OpenAI-compatible server with
            --base-url. Structured output is best effort; parsing is lenient either way.
          </p>
          <a class="mono-link" href="https://github.com/LVTD-LLC/nitpick#local-models">Local models</a>
        </div>
        <div class="feature-panel tone-surface-2">
          <pre class="terminal"><span class="dim">$</span> nitpick -m openai/gpt-5.5 -m anthropic/claude-opus-5-5
<span class="dim">$</span> nitpick --provider ollama -m qwen3-coder:30b
<span class="dim">$</span> nitpick -f <span class="str">"Focus on the SQL; we had injection bugs here before."</span>
<span class="dim">$</span> nitpick --staged --fail-on medium --json
<span class="dim">$</span> nitpick context   <span class="dim"># exact payload, no network</span></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Architectural grid strip -->
  <div class="band grid-strip" aria-hidden="true">
    <div class="frame">
      <div class="cells">
        {Array.from({ length: 12 }).map((_, i) => <span class:list={["cell", { c1: i === 1, c2: i === 9 }]} />)}
      </div>
    </div>
  </div>

  <!-- Bridge -->
  <section class="band" id="how">
    <div class="frame bridge">
      <div class="bridge-copy">
        <h2 class="h-section"><span class="mark mark-lemon">Review your diff like a second engineer would.</span></h2>
        <p class="muted bridge-p">The diff alone is not enough to judge a change.</p>
        <p class="muted bridge-p">
          nitpick reads around it, the way a careful reviewer opens the callers and the tests before commenting.
        </p>
        <p class="mono-line">
          Your <span class="mark mark-sky">DIFF</span> plus <span class="mark mark-sky">CONTEXT</span> for a <span
            class="mark mark-sky">DIFFERENT MODEL</span>
        </p>
        <ul class="mono-list" role="list">
          <li>Definitions of symbols the diff references</li>
          <li>Call sites of symbols the diff changed</li>
          <li>Modules the changed files import</li>
          <li>Files that import each changed file</li>
          <li>Tests that match each changed file</li>
          <li>Ranked, then trimmed to budget_tokens</li>
        </ul>
      </div>
      <div class="bridge-art">
        <img src="/art/field.png" width="960" height="600" alt="" loading="lazy" />
        <div class="window bridge-window">
          <div class="window-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="url">nitpick context --json</span>
          </div>
          <div class="window-body">
            <pre class="terminal">{'{'}
  <span class="key">"changed_files"</span>: 2,
  <span class="key">"snippets"</span>: 6,
  <span class="key">"dropped"</span>: 0,
  <span class="key">"tokens"</span>: 7812,
  <span class="key">"budget_tokens"</span>: 80000,
  <span class="key">"elapsed_ms"</span>: 175
{'}'}</pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="band">
    <div class="frame pad">
      <h2 class="h-section">Anything <span class="accent">a reviewer</span> would check, before the PR.</h2>
      <p class="lede section-lede">Automate the second opinion. Keep the human for the interesting parts.</p>
      <div class="cards">
        {
          capabilities.map((c, i) => (
            <article class="card">
              <div class:list={["card-art", `tone-${c.tone}`]} aria-hidden="true">
                <span class="card-glyph" data-i={i} />
              </div>
              <h3 class="h-card">{c.title}</h3>
              <p class="muted">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Setup selector -->
  <section class="band" id="setup">
    <div class="frame pad">
      <h2 class="h-section center">There&rsquo;s a setup for that</h2>
      <div class="selector" data-selector>
        <div class="selector-list" role="tablist" aria-label="Setup options">
          {
            setups.map((s, i) => (
              <button
                class="selector-item"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                type="button"
              >
                <span>{s.label}</span>
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            ))
          }
        </div>
        <div class="selector-detail">
          {
            setups.map((s, i) => (
              <div
                class="selector-panel"
                role="tabpanel"
                id={`panel-${s.id}`}
                aria-labelledby={`tab-${s.id}`}
                hidden={i !== 0}
              >
                <button class="pill pill-ink copy" data-copy={s.code} type="button">
                  <span class="copy-label">Copy</span>
                </button>
                <p class="selector-blurb">{s.blurb}</p>
                <pre class="terminal selector-code">{s.code}</pre>
                <div class="chips">
                  {s.chips.map(([k, ...vals]) => (
                    <div class="chip-row">
                      <span class="chip-key">{k}</span>
                      {vals.map((v, j) => (
                        <span class:list={["chip", { "chip-ink": j === vals.length - 1 && vals.length > 1 }]}>{v}</span>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="band">
    <div class="frame pad">
      <h2 class="h-section">Zero setup. <span class="accent">Real findings.</span></h2>
      <p class="lede section-lede">Install the binary, set a key, run it from the repo root.</p>
      <div class="steps">
        {
          steps.map((s) => (
            <article class="step">
              <div class="step-art">
                <span class="step-n">{s.n}</span>
                <pre class="terminal step-code">{s.code}</pre>
              </div>
              <h3 class="h-card">{s.title}</h3>
              <p class="muted">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="band">
    <div class="frame cta">
      <h2 class="h-section">Every diff reviewed before the PR.</h2>
      <p class="muted">No GitHub Action. No waiting for CI.</p>
      <p class="muted">The agent that wrote the code gets a second opinion in one command.</p>
      <div class="hero-actions">
        <a class="pill pill-ink" href="https://github.com/LVTD-LLC/nitpick#install">
          Install nitpick
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="pill pill-soft" href="https://github.com/LVTD-LLC/nitpick#readme">
          Read the README
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Big statement -->
  <section class="band">
    <div class="frame statement">
      <div class="statement-copy">
        <h2 class="h-section"><span class="mark mark-pink">Don&rsquo;t wait for CI.</span><br /><span class="mark mark-pink">Review now.</span></h2>
      </div>
      <img class="statement-art" src="/art/peak.png" width="900" height="780" alt="" loading="lazy" />
      <div class="statement-big">
        <p class="eyebrow"><span class="swatch"></span>WHAT THE AGENT WAITS FOR</p>
        <p class="big-number"><span class="mark mark-surface">one command.</span></p>
      </div>
    </div>
  </section>

  <div class="band grid-strip" aria-hidden="true">
    <div class="frame">
      <div class="cells">
        {Array.from({ length: 12 }).map((_, i) => <span class:list={["cell", { c3: i === 10 }]} />)}
      </div>
    </div>
  </div>

  <!-- Stats -->
  <section class="band">
    <div class="frame pad stats-wrap">
      <h2 class="h-section">Built for agents</h2>
      <div class="stats">
        {
          stats.map((s) => (
            <div class:list={["stat", `tone-${s.tone}`]}>
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // Copy buttons
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy")) {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const label = btn.querySelector<HTMLElement>(".copy-label");
      const original = label?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Copy failed";
      }
      window.setTimeout(() => {
        if (label) label.textContent = original;
      }, 1400);
    });
  }

  // Setup selector tabs
  const root = document.querySelector<HTMLElement>("[data-selector]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[role=tabpanel]"));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowRight") {
          e.preventDefault();
          select((i + 1) % tabs.length, true);
        } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
          e.preventDefault();
          select((i - 1 + tabs.length) % tabs.length, true);
        } else if (e.key === "Home") {
          e.preventDefault();
          select(0, true);
        } else if (e.key === "End") {
          e.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });
  }
</script>

<style>
  /* Tones */
  .tone-surface { background: var(--surface); }
  .tone-surface-2 { background: var(--surface-2); }
  .tone-lemon { background: var(--lemon); }
  .tone-pink { background: var(--pink); }
  .tone-sky { background: var(--sky); }
  .tone-mint { background: var(--mint); }
  .tone-paper { background: var(--paper); }

  .center { text-align: center; }

  .section-lede {
    margin-top: 16px;
    max-width: 62ch;
  }

  /* Hero */
  .hero-frame {
    background: var(--surface);
    position: relative;
    overflow: hidden;
  }
  .hero-copy {
    text-align: center;
    padding: 88px var(--gutter) 32px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .hero-copy h1 {
    line-height: 1.18;
  }
  .hero-lede {
    max-width: 44ch;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-art {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    margin-top: -8px;
  }
  @media (max-width: 720px) {
    .hero-copy {
      padding-top: 56px;
    }
    .hero-actions .pill-mono {
      font-size: 13px;
      padding: 0 14px;
    }
  }

  /* Clients strip */
  .clients {
    padding-top: 56px;
    padding-bottom: 64px;
  }
  .clients-title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .clients-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }
  .clients-grid li {
    background: var(--paper);
    height: 88px;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }
